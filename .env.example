OPENAI_API_KEY=
JAHONGIR_CHAT_MODEL=gpt-4.1-mini
JAHONGIR_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
JAHONGIR_REPLY_MAX_TOKENS=420

# Optional: preferred provider for real custom voice output.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY_BOOST=0.82
ELEVENLABS_STYLE=0.2
ELEVENLABS_SPEAKER_BOOST=true
